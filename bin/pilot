#!/bin/sh
# ConfigHub Pilot launcher. Generated by tools/maintainer/pilot-public-channel-build;
# do not edit the copy in the public repository.
#
# This file makes `cub pilot ...` work. It installs one pinned Pilot release into
# its own Python virtual environment, checks the download against a checksum that
# was written into this file when it was built, and adds the Claude plugin when
# Claude Code is on this machine. It needs no administrator rights, asks for no credentials and
# downloads only the one pinned Pilot file.
#
# Settings you can change with environment variables:
#   PILOT_CHANNEL_HOME       where the Pilot environment lives (default ~/.confighub/pilot)
#   PILOT_BIN_DIR            where the `pilot` command link goes (default ~/.local/bin)
#   PILOT_MARKETPLACE_SOURCE where Claude finds the plugin (default confighub/pilot)
#   PILOT_PYTHON             which Python to use (default: the first of python3.13 ...
#                            python3.10, python3 that is version 3.10 or newer)

set -eu

PILOT_VERSION="0.7.0"
PILOT_WHEEL_SHA256="1cb85a0dd52a426ec2a2011bd9e983613cbe8b24675981a566a50deab64b6742"
PILOT_RELEASE_BASE_URL="https://github.com/confighub/pilot/releases/download"
PILOT_WHEEL_NAME="confighub_pilot-${PILOT_VERSION}-py3-none-any.whl"
PILOT_PLUGIN_ID="confighub-pilot@confighub-pilot"
PILOT_MARKETPLACE_NAME="confighub-pilot"

CHANNEL_HOME="${PILOT_CHANNEL_HOME:-${HOME:-}/.confighub/pilot}"
VENV_DIR="$CHANNEL_HOME/venv"
BIN_DIR="${PILOT_BIN_DIR:-${HOME:-}/.local/bin}"
MARKETPLACE_SOURCE="${PILOT_MARKETPLACE_SOURCE:-confighub/pilot}"
TMP_DIR=""
WARNINGS=0
PYTHON_BIN=""
PYTHON_SEEN=""

say() { printf '%s\n' "$*"; }
warn() { WARNINGS=$((WARNINGS + 1)); printf 'Warning: %s\n' "$*"; }
die() { printf 'Stopped: %s\n' "$*" >&2; exit 1; }

cleanup() {
    if [ -n "$TMP_DIR" ] && [ -d "$TMP_DIR" ]; then
        rm -rf "$TMP_DIR"
    fi
}
trap cleanup EXIT INT TERM

have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<EOF
ConfigHub Pilot launcher, version $PILOT_VERSION

  cub pilot install [--wheel PATH]   Install Pilot $PILOT_VERSION (or use a wheel file you already have)
  cub pilot upgrade                  Re-install the Pilot version this launcher is pinned to
  cub pilot uninstall                Remove the Pilot environment and the Claude plugin
  cub pilot version                  Show the launcher version and the installed Pilot version
  cub pilot doctor                   Check that each part is in place
  cub pilot <anything else>          Passed to the installed pilot command

Install page: https://github.com/confighub/pilot#install
EOF
}

# Find a Python that is 3.10 or newer. Try $PILOT_PYTHON first, then python3.13
# down to python3.10, then python3. Sets PYTHON_BIN to the first one that works.
# PYTHON_SEEN names the version of the first Python found that was too old, so
# the stop message can say what this machine has.
find_python() {
    PYTHON_BIN=""
    PYTHON_SEEN=""
    for candidate in "${PILOT_PYTHON:-}" python3.13 python3.12 python3.11 python3.10 python3; do
        [ -n "$candidate" ] || continue
        found="$(command -v "$candidate" 2>/dev/null || true)"
        [ -n "$found" ] || continue
        if "$found" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
            PYTHON_BIN="$found"
            return 0
        fi
        if [ -z "$PYTHON_SEEN" ]; then
            PYTHON_SEEN="$("$found" --version 2>&1 | head -n 1)"
        fi
    done
    return 1
}

installed_pilot() { printf '%s' "$VENV_DIR/bin/pilot"; }

pilot_is_installed() { [ -x "$(installed_pilot)" ]; }

sha256_of() {
    if have sha256sum; then
        sha256sum "$1" | awk '{print $1}'
    elif have shasum; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif [ -n "$PYTHON_BIN" ] || find_python; then
        "$PYTHON_BIN" -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$1"
    else
        die "cannot check the download: none of sha256sum, shasum or a Python 3.10 or newer was found."
    fi
}

lower() { printf '%s' "$1" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz'; }

# Print the command, then run it. A failure is reported by the caller.
run_shown() {
    say "Running: $*"
    "$@"
}

fetch_wheel() {
    # $1 = destination file
    url="$PILOT_RELEASE_BASE_URL/v$PILOT_VERSION/$PILOT_WHEEL_NAME"
    say "Step 2 of 7: downloading Pilot $PILOT_VERSION from $url (this is the only file this installer downloads)."
    if have curl; then
        curl -fsSL "$url" -o "$1" || die "the download failed. Check your network, or download the file yourself and run: cub pilot install --wheel PATH"
    elif have wget; then
        wget -q "$url" -O "$1" || die "the download failed. Check your network, or download the file yourself and run: cub pilot install --wheel PATH"
    else
        die "neither curl nor wget was found. Download $url yourself and run: cub pilot install --wheel PATH"
    fi
}

check_wheel_hash() {
    # $1 = wheel file
    actual="$(lower "$(sha256_of "$1")")"
    expected="$(lower "$PILOT_WHEEL_SHA256")"
    if [ "$actual" != "$expected" ]; then
        printf 'Stopped: the Pilot file does not match the checksum this launcher expects. Nothing was installed.\n' >&2
        printf '  expected %s\n  found    %s\n' "$expected" "$actual" >&2
        exit 1
    fi
    say "Step 3 of 7: checked the file against the pinned checksum ($expected). It matches."
}

install_claude_plugin() {
    if have claude; then
        say "Step 5 of 7: adding the Claude plugin."
        if run_shown claude plugin marketplace add "$MARKETPLACE_SOURCE"; then
            :
        else
            warn "Claude could not add the marketplace. If you have no GitHub SSH key, set CLAUDE_CODE_PLUGIN_PREFER_HTTPS=1 and run this again, or type the two commands below inside Claude Code."
            say "  /plugin marketplace add $MARKETPLACE_SOURCE"
            say "  /plugin install $PILOT_PLUGIN_ID"
            return 0
        fi
        if run_shown claude plugin install "$PILOT_PLUGIN_ID"; then
            :
        else
            warn "Claude could not install the plugin. Type this inside Claude Code: /plugin install $PILOT_PLUGIN_ID"
        fi
    else
        say "Step 5 of 7: Claude Code is not on this machine's PATH, so the plugin was not added. Inside Claude Code, type:"
        say "  /plugin marketplace add $MARKETPLACE_SOURCE"
        say "  /plugin install $PILOT_PLUGIN_ID"
    fi
}

# True when the installed Pilot can add and remove only its own status line.
pilot_has_statusline_install() {
    "$(installed_pilot)" claude statusline --help 2>/dev/null | grep -q -- '--install'
}

# Add Pilot's status line to Claude's settings. It shows only in sessions that
# were switched on with /confighub-pilot:on. It never replaces another status line.
add_claude_statusline() {
    pilot_bin="$(installed_pilot)"
    if pilot_has_statusline_install; then
        if line="$("$pilot_bin" claude statusline --install --pilot-command "$pilot_bin" 2>&1)"; then
            say "Step 6 of 7: $line"
        else
            say "Step 6 of 7: Pilot's status line was not added."
            warn "$line (You can try again later: pilot claude statusline --install)"
        fi
    else
        say "Step 6 of 7: this Pilot version cannot add its status line by itself, so that step was skipped."
    fi
}

remove_claude_statusline() {
    pilot_bin="$(installed_pilot)"
    if [ -x "$pilot_bin" ] && pilot_has_statusline_install; then
        if line="$("$pilot_bin" claude statusline --uninstall 2>&1)"; then
            say "$line"
        else
            warn "$line"
        fi
    fi
}

link_pilot_command() {
    target="$(installed_pilot)"
    mkdir -p "$BIN_DIR" 2>/dev/null || { warn "could not create $BIN_DIR, so there is no 'pilot' shortcut. Run $target directly."; return 0; }
    link="$BIN_DIR/pilot"
    if [ -L "$link" ] || [ ! -e "$link" ]; then
        ln -sf "$target" "$link"
        say "  The 'pilot' command is linked at $link."
    else
        warn "$link already exists and is not a link made by this installer, so it was left alone. Run $target directly."
        return 0
    fi
    case ":${PATH:-}:" in
        *":$BIN_DIR:"*) : ;;
        *) say "  Note: $BIN_DIR is not on your PATH. Add it (for example: export PATH=\"$BIN_DIR:\$PATH\") so Claude sessions can find 'pilot'." ;;
    esac
}

finish_check() {
    pilot_bin="$(installed_pilot)"
    if "$pilot_bin" doctor --help >/dev/null 2>&1; then
        say "Step 7 of 7: checking the install with 'pilot doctor'."
        run_shown "$pilot_bin" doctor || warn "'pilot doctor' reported a problem. Read its output above."
    else
        say "Step 7 of 7: checking the install with 'pilot --version'."
        run_shown "$pilot_bin" --version || warn "'pilot --version' failed. The install may be incomplete."
    fi
}

do_install() {
    wheel=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --wheel)
                [ "$#" -ge 2 ] || die "--wheel needs a file path."
                wheel="$2"
                shift 2
                ;;
            --wheel=*)
                wheel="${1#--wheel=}"
                shift
                ;;
            *)
                die "unknown option '$1'. Usage: cub pilot install [--wheel PATH]"
                ;;
        esac
    done

    if find_python; then
        say "Step 1 of 7: checking Python. Using $PYTHON_BIN ($("$PYTHON_BIN" --version 2>&1))."
    else
        say "Step 1 of 7: checking Python."
        if [ -n "$PYTHON_SEEN" ]; then
            found_text="this machine has $PYTHON_SEEN"
        else
            found_text="no Python 3 was found on this machine"
        fi
        die "Pilot needs Python 3.10 or newer; $found_text. Install Python 3.10 or newer (for example \`brew install python\` on a Mac, or from python.org), then run this again. To use a specific Python, set PILOT_PYTHON=/path/to/python3."
    fi

    TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pilot-install.XXXXXX")"
    if [ -n "$wheel" ]; then
        [ -f "$wheel" ] || die "no file at $wheel."
        say "Step 2 of 7: using the Pilot file you gave: $wheel."
    else
        wheel="$TMP_DIR/$PILOT_WHEEL_NAME"
        fetch_wheel "$wheel"
    fi
    check_wheel_hash "$wheel"

    say "Step 4 of 7: installing the checked file into its own Python environment at $VENV_DIR."
    if [ ! -x "$VENV_DIR/bin/python" ]; then
        mkdir -p "$CHANNEL_HOME"
        "$PYTHON_BIN" -m venv "$VENV_DIR" || die "could not create the Python environment at $VENV_DIR."
    fi
    "$VENV_DIR/bin/python" -m pip install --disable-pip-version-check --quiet "$wheel" \
        || die "pip could not install the Pilot file. Nothing else was changed."

    link_pilot_command
    install_claude_plugin
    add_claude_statusline
    finish_check

    if [ "$WARNINGS" -gt 0 ]; then
        say "Pilot $PILOT_VERSION is installed, with $WARNINGS warning(s) above. Check them before you rely on it."
    else
        say "Pilot $PILOT_VERSION is installed. In Claude Code, type /confighub-pilot:on to switch Pilot on for a session."
    fi
}

do_upgrade() {
    pilot_is_installed || die "Pilot is not installed yet. Run: cub pilot install"
    say "Re-installing the Pilot version this launcher is pinned to ($PILOT_VERSION). To get a newer launcher first, run: cub plugin upgrade pilot"
    do_install
}

do_uninstall() {
    remove_claude_statusline
    say "Removing Pilot's environment at $VENV_DIR."
    if [ -d "$VENV_DIR" ]; then
        rm -rf "$VENV_DIR"
    else
        say "  There was no environment there."
    fi
    link="$BIN_DIR/pilot"
    if [ -L "$link" ]; then
        case "$(readlink "$link")" in
            "$VENV_DIR"/*) rm -f "$link"; say "Removed the 'pilot' link at $link." ;;
            *) say "Left $link alone; it does not point at this installer's environment." ;;
        esac
    fi
    if have claude; then
        say "Removing the Claude plugin."
        run_shown claude plugin uninstall "$PILOT_PLUGIN_ID" || warn "Claude did not remove the plugin. Inside Claude Code, type: /plugin uninstall $PILOT_PLUGIN_ID"
        run_shown claude plugin marketplace remove "$PILOT_MARKETPLACE_NAME" || warn "Claude did not remove the marketplace. Inside Claude Code, type: /plugin marketplace remove $PILOT_MARKETPLACE_NAME"
    else
        say "Claude Code is not on this machine's PATH. Inside Claude Code, type: /plugin uninstall $PILOT_PLUGIN_ID"
    fi
    say "Your Pilot notes and history under ~/.pilot were kept. Delete that folder yourself if you want them gone."
    say "Pilot is uninstalled."
}

do_version() {
    say "Pilot launcher $PILOT_VERSION"
    if pilot_is_installed; then
        "$(installed_pilot)" --version || true
    else
        say "Pilot is not installed. Run: cub pilot install"
    fi
}

do_doctor() {
    problems=0
    if find_python; then
        say "OK    Python found: $PYTHON_BIN ($("$PYTHON_BIN" --version 2>&1))"
    else
        say "FAIL  no Python 3.10 or newer found${PYTHON_SEEN:+ (this machine has $PYTHON_SEEN)}. Install one, or set PILOT_PYTHON=/path/to/python3."
        problems=$((problems + 1))
    fi
    if pilot_is_installed; then
        say "OK    Pilot environment at $VENV_DIR"
        "$(installed_pilot)" --version || problems=$((problems + 1))
    else
        say "FAIL  no Pilot environment at $VENV_DIR (run: cub pilot install)"
        problems=$((problems + 1))
    fi
    if have pilot; then say "OK    'pilot' is on your PATH ($(command -v pilot))"; else say "WARN  'pilot' is not on your PATH; Claude sessions will not find it (see $BIN_DIR)"; fi
    if have claude; then
        if claude plugin list 2>/dev/null | grep -q "$PILOT_MARKETPLACE_NAME"; then
            say "OK    the Claude plugin is installed"
        else
            say "WARN  the Claude plugin is not installed (inside Claude Code: /plugin install $PILOT_PLUGIN_ID)"
        fi
    else
        say "INFO  Claude Code is not on your PATH; skipped the plugin check"
    fi
    if pilot_is_installed && "$(installed_pilot)" doctor --help >/dev/null 2>&1; then
        "$(installed_pilot)" doctor || problems=$((problems + 1))
    fi
    if [ "$problems" -gt 0 ]; then
        say "Pilot needs attention: $problems problem(s) above."
        exit 1
    fi
    say "Pilot looks fine."
}

main() {
    if [ "$#" -eq 0 ]; then
        usage
        exit 0
    fi
    cmd="$1"
    shift
    case "$cmd" in
        install) do_install "$@" ;;
        upgrade) do_upgrade ;;
        uninstall) do_uninstall ;;
        version) do_version ;;
        doctor) do_doctor ;;
        help) usage ;;
        *)
            pilot_is_installed || die "Pilot is not installed yet. Run: cub pilot install"
            exec "$(installed_pilot)" "$cmd" "$@"
            ;;
    esac
}

main "$@"
